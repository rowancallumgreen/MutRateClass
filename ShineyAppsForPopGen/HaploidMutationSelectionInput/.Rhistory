## leading eigenvalue
lambda1 <- eigen(L)$val[1]
## right eigenvector
r.vec1 <- eigen(L)$vectors[,1]/sum(eigen(L)$vectors[,1])
## left eigenvector, satisfyying u.v=1
l.vec1 <- eigen(t(L))$vectors[,1]
l.vec1 <- l.vec1/sum(r.vec1 * l.vec1)
## stable age distribution
r.vec1
## reproductive value
l.vec1
sum(n.1991*l.vec1)
## into the future
lambda1^1 * r.vec1 * as.numeric(l.vec1 %*% n.1991)
lambda1^2 * r.vec1 * as.numeric(l.vec1 %*% n.1991)
lambda1^3 * r.vec1 * as.numeric(l.vec1 %*% n.1991)
