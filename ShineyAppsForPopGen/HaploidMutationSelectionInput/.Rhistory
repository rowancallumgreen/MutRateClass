n.1991 <- c(5798100, 5460500, 2430500)
names(n.1991) <- c('0-29','30-59','60+')
'%^%'<-function(A,n) {
if(n==1) A else {
B <- A
for(i in (2:n)) A<-A %*% B
};
A
}
n.2021 <- as.vector((L %^% 1) %*% n.1991)
n.2051 <- as.vector((L %^% 2) %*% n.1991)
n.2081 <- as.vector((L %^% 3) %*% n.1991)
names(n.2021) <- names(n.1991)
names(n.2051) <- names(n.1991)
names(n.2081) <- names(n.1991)
## figure with projections for 3 age classes
